---
// Override of Starlight's default ThemeSelect using the ripple-style
// toggle from `astro-theme-toggle`. We bridge `window.astroThemeToggle`
// (which the package's `handleToggleClick` looks for) to Starlight's
// own storage / data-theme attribute, so the visual animation comes
// from the package but persistence + the rest of the doc theming stay
// 100% on Starlight's rails.
import { Toggle } from "astro-theme-toggle/components";
---

<Toggle
  class="gitoui-theme-toggle"
  style="width: 1.4rem; height: 1.4rem;"
  aria-label={Astro.locals.t("themeSelect.accessibleLabel")}
/>

<script is:inline>
  (function () {
    const KEY = "starlight-theme";
    function applied() {
      const stored = localStorage.getItem(KEY);
      if (stored === "light" || stored === "dark") return stored;
      return matchMedia("(prefers-color-scheme: light)").matches
        ? "light"
        : "dark";
    }
    // astro-theme-toggle's handleToggleClick reads / writes via
    // window.astroThemeToggle; wire it to Starlight's storage.
    window.astroThemeToggle = {
      getTheme() {
        return document.documentElement.dataset.theme === "light"
          ? "light"
          : "dark";
      },
      setTheme(theme) {
        document.documentElement.dataset.theme = theme;
        document.documentElement.classList.toggle("dark", theme === "dark");
        document.documentElement.style.colorScheme = theme;
        localStorage.setItem(KEY, theme);
        if (window.StarlightThemeProvider) {
          window.StarlightThemeProvider.updatePickers(theme);
        }
      },
    };
    // Force the .dark class to match current state so the package's
    // icon-swap CSS (`.dark & { display: block }`) picks the right one
    // from the first paint.
    document.documentElement.classList.toggle("dark", applied() === "dark");
  })();
</script>

<style is:global>
  /* Match the header link styling so the toggle sits nicely next to
     the Install / Docs / GitHub pills. */
  astro-theme-toggle.gitoui-theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.35rem;
    color: var(--sl-color-text);
    border-radius: 0.375rem;
    transition: background-color 120ms ease, color 120ms ease;
  }
  astro-theme-toggle.gitoui-theme-toggle:hover {
    background: var(--sl-color-gray-5);
    color: var(--sl-color-white);
  }
  astro-theme-toggle.gitoui-theme-toggle svg {
    width: 1.1rem;
    height: 1.1rem;
  }
</style>
