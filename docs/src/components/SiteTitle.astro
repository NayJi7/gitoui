---
// Override of Starlight's default SiteTitle — same logo handling, but
// the "gitoui" title splits into <git-part> + <oui-part> so the brand
// wordmark colors (#F05133 orange / #F1ECEC cream) apply per the brand
// book. A tiny "vX.Y.Z" pulled from the workspace Cargo.toml at build
// time sits to the right of the wordmark.
import { logos } from "virtual:starlight/user-images";
import config from "virtual:starlight/user-config";
// `?raw` tells Vite to inline the file as a string at build time, no
// matter where the compiled component lands.
import cargoToml from "../../../Cargo.toml?raw";

// Starlight 0.39 moved per-route data off Astro.props onto a shared
// locals object — see https://starlight.astro.build/manual-setup/
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;

// Split the title at the canonical brand cleave (`git` + `oui`). For any
// other title string we fall back to a single span so this override
// stays safe if someone forks the docs and renames the project.
const m = /^(git)(oui)$/i.exec(siteTitle);
const front = m?.[1];
const back = m?.[2];

// Grep for the first `version = "X.Y.Z"` in the workspace Cargo.toml
// — that's the [package] entry near the top of the file.
const versionMatch = cargoToml.match(/^\s*version\s*=\s*"([^"]+)"/m);
const version = versionMatch?.[1];
---

<a href={siteTitleHref} class="site-title sl-flex">
  {
    config.logo && logos.dark && (
      <>
        <img
          class:list={{ "light:sl-hidden": !("src" in config.logo) }}
          alt={config.logo.alt}
          src={logos.dark.src}
          width={logos.dark.width}
          height={logos.dark.height}
          loading="eager"
          decoding="sync"
          fetchpriority="high"
        />
        {!("src" in config.logo) && (
          <img
            class="dark:sl-hidden"
            alt={config.logo.alt}
            src={logos.light?.src}
            width={logos.light?.width}
            height={logos.light?.height}
            loading="eager"
            decoding="sync"
            fetchpriority="high"
          />
        )}
      </>
    )
  }
  <span class:list={{ "sr-only": config.logo?.replacesTitle }} translate="no">
    {
      front && back ? (
        <Fragment><span class="git-part">{front}</span><span class="oui-part">{back}</span></Fragment>
      ) : (
        siteTitle
      )
    }
  </span>
  {version && <span class="site-version" aria-label={`Version ${version}`}>v{version}</span>}
</a>

<style>
  .site-title {
    align-items: center;
    gap: var(--sl-nav-gap);
    font-size: var(--sl-text-h4);
    font-weight: 600;
    color: var(--sl-color-text-accent);
    text-decoration: none;
    white-space: nowrap;
  }
  img {
    height: calc(var(--sl-nav-height) - 2 * var(--sl-nav-pad-y));
    width: auto;
    max-width: 100%;
    object-fit: contain;
    object-position: 0 50%;
  }
  /* Tiny version tag to the right of the wordmark — same monospace
     font as the rest of the project's code text, gray, baseline-aligned
     so it sits flush with the wordmark's baseline. */
  .site-version {
    font-family: var(--sl-font-mono, ui-monospace, "JetBrains Mono", monospace);
    font-size: 0.65rem;
    font-weight: 500;
    color: var(--sl-color-gray-3);
    letter-spacing: 0.02em;
    align-self: end;
    margin-bottom: 0.25rem;
    margin-left: -0.25rem;
  }
</style>
